rules_version = '2';

// OPEN ACCESS: anyone who has the site's address can read, change and delete
// every card. There is no sign-in. To lock this down later, add Firebase
// Authentication and replace "if true" with a check on request.auth.
service cloud.firestore {
  match /databases/{database}/documents {
    match /doctors/{doctorId} {
      allow read, write: if true;

      // Earlier versions of this doctor, for history and restore.
      match /versions/{versionId} {
        allow read, write: if true;
      }
    }
    // Deleted doctors, kept for 30 days so they can be restored.
    match /deletedDoctors/{doctorId} {
      allow read, write: if true;
    }
    match /meta/{docId} {
      allow read, write: if true;
    }
  }
}
